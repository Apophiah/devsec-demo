# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# All variables are read by devsec_demo/settings.py at startup.
# Variables marked [required] must be set or the server will refuse to start.
# Variables marked [optional] have safe production defaults shown below.

# ── Required ──────────────────────────────────────────────────────────── #

# Long random string used for cryptographic signing (sessions, tokens, etc.).
# Generate a fresh value with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# [required]
DJANGO_SECRET_KEY=

# ── Core settings ─────────────────────────────────────────────────────── #

# Enable Django debug mode and detailed error pages.
# Set to 'true' (or '1' / 'yes') ONLY for local development.
# Default: false (production-safe — opt IN to debug, never opt OUT)
# [optional]
DJANGO_DEBUG=false

# Comma-separated list of hostnames/IP addresses Django will serve.
# Example: DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# Default: 127.0.0.1,localhost
# [optional]
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── Email ─────────────────────────────────────────────────────────────── #

# Dotted Python path to the email backend class.
# Default: django.core.mail.backends.console.EmailBackend  (prints to stdout)
# For production SMTP delivery set to:
#   django.core.mail.backends.smtp.EmailBackend
# and configure EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER etc. in settings.
# [optional]
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── Session ───────────────────────────────────────────────────────────── #

# Session cookie lifetime in seconds.
# Default: 3600 (1 hour) — short sessions limit damage from stolen tokens.
# [optional]
DJANGO_SESSION_COOKIE_AGE=3600

# ── Reverse-proxy TLS termination ─────────────────────────────────────── #

# Set to 'true' when a trusted reverse proxy (nginx, Caddy, …) terminates
# TLS and forwards the X-Forwarded-Proto header to Django.
# NEVER set this if Django is directly internet-facing over HTTP.
# Default: false
# [optional]
DJANGO_BEHIND_PROXY=false
